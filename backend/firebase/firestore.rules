rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidRoute() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'distance', 'time', 'difficulty'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 200;
    }

    function isValidCommunityPost() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'route', 'comment', 'createdAt'])
        && data.userId is string
        && data.comment is string
        && data.comment.size() < 1000
        && data.userId == request.auth.uid;
    }

    // ============================================================
    // Users collection
    // ============================================================

    match /users/{userId} {
      // Users can read/write only their own document
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      // Saved routes subcollection
      match /savedRoutes/{routeId} {
        // Users can read/write/delete their own saved routes
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRoute();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ガレージ（愛車）subcollection — 自分のみ読み書き可
      match /bikes/{bikeId} {
        allow read, write: if isOwner(userId);

        // ツーリング前チェックリスト履歴
        match /checklists/{checklistId} {
          allow read, create, delete: if isOwner(userId);
          allow update: if false; // 履歴は不変（作成と削除のみ）
        }
      }

      // ツーリングアルバム（走行ログ）— 自分のみ読み書き可
      match /tours/{tourId} {
        allow read, write: if isOwner(userId)
          && (!('photos' in request.resource.data) || request.resource.data.photos.size() <= 10);
      }
    }

    // ============================================================
    // Community posts collection
    // ============================================================

    match /communityPosts/{postId} {
      // Anyone authenticated can read community posts
      allow read: if isAuthenticated();

      // Only the post owner can create posts
      allow create: if isAuthenticated()
        && isValidCommunityPost()
        && request.resource.data.photos.size() <= 10;

      // Post owner can update (edit comment, etc.)
      // Any authenticated user can like (update likes and likedBy only)
      allow update: if isAuthenticated() && (
        // Owner updates
        isOwner(resource.data.userId) ||
        // Like toggle: only likes and likedBy fields change
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
          && request.resource.data.likes is int
          && request.resource.data.likes >= 0)
      );

      // Only the post owner can delete their post
      allow delete: if isOwner(resource.data.userId);
    }

    // ============================================================
    // Reports（UGC通報）— App Store 審査ガイドライン 1.2 対応
    // クライアントは作成のみ。閲覧・対応は Firebase Console から行う
    // ※ アプリは Firebase Auth 未使用（AsyncStorage匿名UID）のため未認証で許可
    // ============================================================

    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasAll(['postId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() < 200;
      allow read, update, delete: if false; // 運営のみ（Firebase Console / Admin SDK）
    }

    // ============================================================
    // User profiles（プッシュトークン・プロフィール写真・BANフラグ）
    // banned フィールドは Firebase Console から手動設定
    // ============================================================

    match /userProfiles/{userId} {
      allow read: if true;
      // banned フィールドはクライアントから変更不可
      allow write: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned']);
    }

    // ============================================================
    // App config (read-only for authenticated users)
    // ============================================================

    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via Firebase Admin SDK
    }
  }
}
