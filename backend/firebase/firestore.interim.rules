rules_version = '2';

// ============================================================
// 【移行期ルール】Firebase Auth 導入直後の段階的ルール
//
// 方針:
//   閲覧      … 全員に許可（未ログインでもフィードを見られる状態を維持）
//   SNS機能   … ログイン必須（投稿・グループ・計画）＝ なりすまし防止
//   個人機能  … 未ログインでも利用可（ガレージ・アルバム・チェックリスト）
//
// 【残る課題】
// フォロー機能は相手ユーザーの followers サブコレクションへ書き込むため、
// users/** に「自分のパスのみ」という制限をかけられない。
// 完全なオーナー制限には followers 側の同期を Cloud Functions へ移す必要がある。
// それまではアプリ側のガードとログイン必須化で実質的な抑止としている。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // コミュニティ投稿
    // 作成は本人のみ。更新はいいね等があるため緩め、削除は投稿者のみ。
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ユーザープロフィール（プッシュトークン・写真・バイク一覧・BANフラグ）
    match /userProfiles/{userId} {
      allow read: if true;
      // banned フィールドはクライアントから変更不可（Firebase Console からのみ）
      allow create: if !('banned' in request.resource.data);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned']);
      allow delete: if false;
    }

    // ユーザーデータ（保存ルート・ガレージ・チェックリスト・アルバム・フォロー関係）
    // ガレージ等はログインなしでも使える機能のため書き込みを開けている。
    // 旧UIDからの移行処理もこのパスを読み書きする。
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // グループ（本体・メンバー・参加申請）— 参加・作成はログイン必須
    match /groups/{groupId}/{document=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    // ツーリング計画（本体・参加者・参加申請）— 募集・参加はログイン必須
    // ※ 公開範囲（フォロワーのみ / グループ限定）の絞り込みは現状クライアント側。
    //   厳密な秘匿にはサーバー側での判定が必要（今後の課題）。
    match /plans/{planId}/{document=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    // UGC通報（作成のみ。閲覧・対応は Firebase Console から）
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasAll(['postId', 'reporterUid', 'reason'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() < 200;
      allow read, update, delete: if false;
    }

    // アプリ設定（読み取りのみ）
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
