rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // Helper functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidImageSize() {
      // Max 10MB per image
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // ============================================================
    // Community photos
    // match /community/{userId}/{filename}
    // ============================================================

    match /community/{userId}/{filename} {
      // Authenticated users can read community photos
      allow read: if isAuthenticated();

      // Users can only upload to their own folder
      allow create: if isOwner(userId)
        && isImage()
        && isValidImageSize();

      // Users can overwrite their own photos
      allow update: if isOwner(userId)
        && isImage()
        && isValidImageSize();

      // Users can delete their own photos
      allow delete: if isOwner(userId);
    }

    // ============================================================
    // User avatars
    // match /avatars/{userId}
    // ============================================================

    match /avatars/{userId} {
      // Anyone can read avatars
      allow read: if true;

      // Users can only upload their own avatar
      allow write: if isOwner(userId)
        && isImage()
        && request.resource.size <= 2 * 1024 * 1024; // Max 2MB for avatars
    }

    // ============================================================
    // ツーリングアルバム写真
    // users/{userId}/tours/{tourId}/{photoId}.jpg
    //
    // 【暫定ルール】アプリは Firebase Auth 未使用（AsyncStorage匿名UID）のため
    // request.auth によるオーナーチェックが現状機能しない。
    // 1MB上限＋画像のみの制限で当面運用し、Firebase 匿名認証の導入後に
    // 下のコメントアウト版（本来ルール）へ切り替えること。
    // ============================================================

    match /users/{userId}/tours/{tourId}/{photoId} {
      allow read: if true;
      // 1MB以下の画像のみ（クライアントは長辺1280px/JPEG q0.7 に圧縮済み）
      allow write: if request.resource != null
        && isImage()
        && request.resource.size < 1 * 1024 * 1024;
      allow delete: if true;
    }

    // ─── 本来のルール（Firebase Auth 導入後に上のブロックと差し替え） ───
    // match /users/{userId}/tours/{tourId}/{photoId} {
    //   allow read: if isAuthenticated();
    //   allow write: if isOwner(userId)
    //     && isImage()
    //     && request.resource.size < 1 * 1024 * 1024;
    //   allow delete: if isOwner(userId);
    // }

    // ============================================================
    // Block all other paths by default
    // ============================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
